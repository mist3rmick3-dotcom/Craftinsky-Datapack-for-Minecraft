# Particules de lancement sur les nouveaux armor stands
execute as @e[type=armor_stand,tag=mc_moss_new] at @s run particle minecraft:spore_blossom_air ~ ~ ~ 0.3 0.5 0.3 0.5 10
execute as @e[type=armor_stand,tag=mc_moss_new] run tag @s remove mc_moss_new
# Initialiser le timer à 0 pour les nouveaux armor stands
execute as @e[type=armor_stand,tag=mc_moss_convert,scores={mc_moss_timer=..0}] run scoreboard players set @s mc_moss_timer 0
